<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MetroNudge"
            android:textColor="@color/w_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/w_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/w_fg"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/w_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_buy"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:text="Buy ticket"
            android:textColor="@color/w_primary_fg"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_ticket"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_secondary"
            android:gravity="center"
            android:text="Show ticket"
            android:textColor="@color/w_fg"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
